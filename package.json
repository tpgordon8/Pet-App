{
  "name": "tailr",
  "version": "2.0.0",
  "type": "module",
  "description": "Tailr - Pet Activity Logger (Vue 3 Rebuild)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:firebase-rules": "firebase emulators:exec --only database 'npm run test:unit -- tests/firebase-rules.test.js'",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "doc-sync": "bash scripts/doc-sync.sh",
    "deploy:rules": "firebase deploy --only database",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:all": "firebase deploy"
  },
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^3.2.0",
    "@vueuse/core": "^10.9.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "firebase": "^10.14.1",
    "jspdf": "^2.5.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "firebase-admin": "^13.7.0",
    "firebase-tools": "^13.27.0",
    "happy-dom": "^20.8.4",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "puppeteer-core": "^24.40.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.19.8",
    "vitest": "^1.4.0"
  },
  "private": true
}
