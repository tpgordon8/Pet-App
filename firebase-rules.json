{
  "rules": {
    "pets": {
      ".read": true,
      ".write": true,
      "$petId": {
        ".validate": "newData.hasChildren(['name', 'type'])"
      }
    },
    "activities": {
      ".read": true,
      ".write": true,
      "$activityId": {
        ".validate": "newData.hasChildren(['petId', 'type', 'timestamp'])"
      }
    }
  }
}
