{
  "rules": {
    "pets": {
      ".read": true,
      ".write": true,
      ".indexOn": ["name", "createdAt"]
    },
    "activities": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp", "petId", "type"]
    },
    "medications": {
      ".read": true,
      ".write": true,
      "$petId": {
        ".indexOn": ["active", "createdAt"]
      }
    }
  }
}
