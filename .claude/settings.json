{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "autoAllow": [
      {
        "tool": "Bash",
        "pattern": "^git (status|branch|log|diff|fetch|pull|show).*"
      },
      {
        "tool": "Bash",
        "pattern": "^npm (run (dev|lint|test|test:unit|test:unit:run|build|preview)|install)$"
      },
      {
        "tool": "Bash",
        "pattern": "^node --version$"
      },
      {
        "tool": "Bash",
        "pattern": "^npm --version$"
      }
    ]
  }
}
